#include <winver.h>

101 ICON "sonora.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Sonora"
            VALUE "FileDescription",  "Sonora Local Music Player"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Sonora"
            VALUE "OriginalFilename", "Sonora.exe"
            VALUE "ProductName",      "Sonora"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
